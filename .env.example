# docker compose가 backend 컨테이너에 그대로 전달하는 환경변수 목록입니다.
# 이 파일을 .env로 복사한 뒤 값을 채워 사용하세요.

# ===== 필수 =====
# MySQL (compose에 포함되지 않으므로 외부 DB 주소를 입력)
DB_URL=jdbc:mysql://host:3306/gsmc
DB_USERNAME=
DB_PASSWORD=

# Redis (compose의 redis 서비스를 쓰면 host는 redis)
REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

DATAGSM_OPENAPI_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== 선택 (주석의 값이 기본값) =====
# APP_ENVIRONMENT=local
# API_DOCS_ENABLED=false
# GRAPHQL_DEV_ANONYMOUS_ACCESS_ENABLED=false
# FLYWAY_BASELINE_VERSION=10
# ACADEMIC_CURRICULUM_PATH=classpath:academic-curriculum.yml
# DATAGSM_OPENAPI_BASE_URL=https://openapi.datagsm.kr
# DATAGSM_OPENAPI_CONNECT_TIMEOUT=3s
# DATAGSM_OPENAPI_READ_TIMEOUT=5s
# DATAGSM_OPENAPI_TOTAL_TIMEOUT=10s
# DISCORD_GRAPHQL_LATENCY_WEBHOOK_URL=
# DISCORD_ERROR_ALERT_ENABLED=false
# DISCORD_ERROR_ALERT_WEBHOOK_URL=
# DISCORD_ERROR_ALERT_SUPPRESSION_WINDOW=5m
# DISCORD_ERROR_ALERT_QUEUE_CAPACITY=100
# DISCORD_ERROR_ALERT_CACHE_MAX_SIZE=1000
# DISCORD_ERROR_ALERT_CONNECT_TIMEOUT=1s
# DISCORD_ERROR_ALERT_READ_TIMEOUT=2s
