"""회원 검색 결과의 정렬 방향입니다."""
enum SortDirection {
    """오름차순으로 정렬합니다."""
    ASC
    """내림차순으로 정렬합니다."""
    DESC
}

"""회원 검색 조건입니다. 지정하지 않은 조건은 검색 필터에서 제외됩니다."""
input SearchMemberInput {
    """이메일 검색 조건입니다."""
    email: String
    """이름 검색 조건입니다."""
    name: String
    """역할 검색 조건입니다."""
    role: UserRole
    """학년 검색 조건입니다."""
    grade: Int
    """반 검색 조건입니다."""
    classNumber: Int
    """번호 검색 조건입니다."""
    number: Int
    """페이지당 결과 수입니다. 기본값은 100이며 1 이상 100 이하여야 합니다."""
    limit: Int = 100
    """0부터 시작하는 페이지 번호입니다."""
    page: Int = 0
    """정렬 방향입니다."""
    sort: SortDirection = ASC
}

"""클라이언트에 제공하는 회원 정보입니다."""
type MemberPayload {
    id: ID!
    name: String!
    email: String!
    grade: Int
    classNumber: Int
    number: Int
    role: UserRole!
}

"""회원 검색의 페이지 응답입니다."""
type SearchMemberPayload {
    """현재 페이지의 회원 목록입니다. 결과가 없으면 빈 배열입니다."""
    members: [MemberPayload!]!
    """전체 페이지 수입니다."""
    totalPages: Int!
    """검색 조건에 맞는 전체 회원 수입니다."""
    totalElements: Int!
}

extend type Query {
    """식별자로 회원 한 명을 조회합니다. 인증된 사용자가 호출할 수 있습니다."""
    member(memberId: ID!): MemberPayload!
    """현재 인증된 사용자의 회원 정보를 조회합니다."""
    myMember: MemberPayload!
    """조건과 페이지 정보를 사용해 회원을 검색합니다. 인증된 사용자가 호출할 수 있습니다."""
    searchMembers(input: SearchMemberInput!): SearchMemberPayload!
}
