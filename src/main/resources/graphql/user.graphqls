"""이전 클라이언트 계약에서 사용하는 사용자 정보입니다."""
type User {
    userId: ID!
    userName: String!
    userEmail: String!
    userGrade: Int
    userClassNumber: Int
    userNumber: Int
    userRole: UserRole!
}

"""인증과 API 권한 검사에 사용하는 사용자 역할입니다."""
enum UserRole {
    """권한이 부여되지 않은 사용자입니다."""
    UNAUTHORIZED
    """학생 사용자입니다."""
    STUDENT
    """교사 사용자입니다."""
    TEACHER
    """최상위 관리자입니다."""
    ROOT
    """담임 교사 사용자입니다."""
    HOMEROOM_TEACHER
}
