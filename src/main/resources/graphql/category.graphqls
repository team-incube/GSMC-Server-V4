"""점수 계산과 증빙 요구사항을 정의하는 카테고리입니다."""
type Category {
    categoryId: ID!
    categoryType: CategoryType
    categoryEnglishName: String
    categoryKoreanName: String
    weight: Int
    categoryMaximumValue: Int
    isAccumulated: Boolean
    evidenceType: EvidenceType
    calculationType: ScoreCalculationType
}

"""점수 카테고리 유형입니다."""
enum CategoryType {
    CERTIFICATE
    TOPCIT
    TOEIC
    JLPT
    JPT
    TOEIC_ACADEMY
    READ_A_THON
    VOLUNTEER
    PROJECT_PARTICIPATION
    AWARD
    ACADEMIC_GRADE
    EXTERNAL_ACTIVITY
    NCS
    NEWRROW_SCHOOL
}

"""카테고리가 요구하는 증빙 방식입니다."""
enum EvidenceType {
    """별도의 증빙자료가 필요합니다."""
    EVIDENCE
    """파일 첨부가 필요합니다."""
    FILE
    """증빙자료나 파일이 필요하지 않습니다."""
    UNREQUIRED
}

"""카테고리 점수 계산 방식입니다."""
enum ScoreCalculationType {
    """신청 건수를 기준으로 계산합니다."""
    COUNT_BASED
    """입력 점수 값을 기준으로 계산합니다."""
    SCORE_BASED
}

"""클라이언트의 카테고리 선택과 표시에 사용하는 응답입니다."""
type CategoryPayload {
    categoryType: CategoryType!
    englishName: String!
    koreanName: String!
    weight: Int!
    maxRecordCount: Int!
    evidenceType: EvidenceType!
    calculationType: ScoreCalculationType!
}

extend type Query {
    """사용 가능한 전체 카테고리 목록을 반환합니다."""
    categories: [CategoryPayload!]!
    """한글명 또는 영문명 키워드로 카테고리를 검색합니다."""
    searchCategories(keyword: String): [CategoryPayload!]!
}
