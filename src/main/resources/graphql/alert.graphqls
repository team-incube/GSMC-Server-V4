"""현재 사용자에게 전달된 점수 처리 알림입니다."""
type Alert {
    alertId: ID!
    scoreId: ID
    alertType: AlertType!
    content: String!
    isRead: Boolean!
    createdAt: DateTime!
}

"""알림이 생성된 사건 유형입니다."""
enum AlertType {
    """점수 추가 사건을 나타냅니다."""
    ADD_SCORE
    """점수가 승인되었습니다."""
    APPROVED
    """점수가 반려되었습니다."""
    REJECTED
}

"""지정 알림까지 읽음 처리하기 위한 입력입니다."""
input PatchAlertIsReadInput {
    """읽음 처리 범위의 마지막 알림 식별자입니다."""
    lastAlertId: ID!
}

extend type Query {
    """기존 클라이언트 호환성을 위해 유지하는 현재 사용자의 전체 알림 목록입니다."""
    myAlerts: [Alert!]!
    """
    현재 사용자의 알림을 최신순으로 조회하는 커서 기반 페이지입니다.

    정렬은 createdAt 내림차순, alertId 내림차순이며 first의 기본값은 20, 최댓값은 100입니다.
    after가 null이면 첫 페이지를 반환합니다.
    """
    myAlertConnection(first: Int = 20, after: String): AlertConnection!
}

"""알림 페이지의 항목과 다음 페이지 조회용 커서입니다."""
type AlertEdge {
    """페이지에 포함된 알림입니다."""
    node: Alert!
    """해당 알림의 생성 시각과 식별자를 인코딩한 불투명 커서입니다."""
    cursor: String!
}

"""알림 페이지의 다음 조회 가능 여부와 마지막 커서입니다."""
type AlertPageInfo {
    """endCursor로 이어서 조회할 다음 페이지가 존재하는지 나타냅니다."""
    hasNextPage: Boolean!
    """현재 페이지 마지막 알림의 커서이며, 빈 페이지이면 null입니다."""
    endCursor: String
}

"""커서 기반 알림 페이지 응답입니다."""
type AlertConnection {
    """현재 페이지의 알림 항목입니다. 결과가 없으면 빈 배열입니다."""
    edges: [AlertEdge!]!
    """페이지 탐색 정보입니다."""
    pageInfo: AlertPageInfo!
}

extend type Mutation {
    """현재 사용자의 지정 알림까지 읽음 처리합니다."""
    patchAlertIsRead(input: PatchAlertIsReadInput!): Boolean!
    """현재 사용자가 받은 알림 한 건을 삭제합니다."""
    deleteAlert(alertId: ID!): Boolean!
}
